# a failure carries no status
diff --git a/LeanHttp/Exchange.lean b/LeanHttp/Exchange.lean
index 65a9c4b..de54c53 100644
--- a/LeanHttp/Exchange.lean
+++ b/LeanHttp/Exchange.lean
@@ -678,7 +678,7 @@ private def failNow (cause : Cause) (detail : String := "") : StepM Unit := do
     let detail :=
       if detail.isEmpty then (ex.writeError.map (s!"a write failed earlier: {·}")).getD "" else detail
     let failure : Failure := {
-      cause, delivery := ex.delivery, written := ex.written, status := ex.head.map (·.status),
+      cause, delivery := ex.delivery, written := ex.written, status := none,
       detail }
     setEx { ex with phase := .failed failure, writeBy := none, readBy := none, drainBy := none }
     emit (.fail failure)
