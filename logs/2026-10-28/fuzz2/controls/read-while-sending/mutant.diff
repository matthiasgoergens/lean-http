# a read is asked for before the request head is written
diff --git a/LeanHttp/Exchange.lean b/LeanHttp/Exchange.lean
index 65a9c4b..5536e65 100644
--- a/LeanHttp/Exchange.lean
+++ b/LeanHttp/Exchange.lean
@@ -613,7 +613,7 @@ Whether the core wants input now.
 def wantsInput (ex : Exchange) : Bool :=
   !ex.inputEnded &&
     match ex.phase with
-    | .awaitingHead | .draining => true
+    | .sending | .awaitingHead | .draining => true
     | .receiving => !ex.bodyDone && ex.credit > 0
     | _ => false
 
