+# tls_abi <headers dir>: the hand-written OpenSSL declarations against real headers, and the version
+# of the OpenSSL the toolchain links.
+tls_abi() {
+  local cc=${CC:-cc} rc=0 lib found
+  echo "\$ $cc -std=c11 -Wall -Wextra -Werror -fsyntax-only -I $1 native/openssl-check.c"
+  "$cc" -std=c11 -Wall -Wextra -Werror -fsyntax-only -I "$1" native/openssl-check.c \
+    && echo "openssl-min.h agrees with OpenSSL 3.6.0's headers" || rc=1
+  if [ -f /usr/include/openssl/ssl.h ]; then
+    "$cc" -std=c11 -Wall -Wextra -Werror -fsyntax-only native/openssl-check.c \
+      && echo "openssl-min.h agrees with the system's headers: $(grep 'define OPENSSL_VERSION_TEXT' /usr/include/openssl/opensslv.h)" \
+      || rc=1
+  else
+    echo "no system OpenSSL headers to compare with as well"
+  fi
+  lib=$(lean --print-prefix)/lib/libcrypto.a
+  found=$(grep --text --only-matching --extended-regexp 'OpenSSL [0-9]+\.[0-9]+\.[0-9]+' "$lib" | sort --unique)
+  echo "$lib: $found"
+  [ "$found" = "OpenSSL 3.6.0" ] || { echo "the toolchain's OpenSSL is not the 3.6.0 the check compares with"; rc=1; }
+  return $rc
