From 4331720b83411883bb79dac9244d4fb7ac25197c Mon Sep 17 00:00:00 2001
From: Matthias Goergens <matthias.goergens@gmail.com>
Date: Mon, 2 Nov 2026 16:51:20 +0800
Subject: [PATCH 3/3] Sweep a token's entries only once enough calls on it have
 ended

Std's unregisterFn scans every entry of the token, so a call's end on a
token shared by k calls in flight cost O(k).  The client now counts, per token,
the calls registered and those ended since the last sweep, and a call's end
sweeps only once as many have ended as remain (and when the last one ends).
---
 LeanHttp/Cancel.lean | 62 ++++++++++++++++++++++++++++++++++++++++----
 LeanHttp/Client.lean | 10 +++++--
 Tests/Unit.lean      | 11 ++++----
 3 files changed, 71 insertions(+), 12 deletions(-)

diff --git a/LeanHttp/Cancel.lean b/LeanHttp/Cancel.lean
index 6856655..3c50d4d 100644
--- a/LeanHttp/Cancel.lean
+++ b/LeanHttp/Cancel.lean
@@ -44,6 +44,37 @@ set_option linter.all true
 
 open Std.Async
 
+/--
+The address of a token's state, which tells tokens apart while they live.
+-/
+private unsafe def tokenKeyImpl (token : Std.CancellationToken) : USize :=
+  ptrAddrUnsafe token.state
+
+@[implemented_by tokenKeyImpl]
+private opaque tokenKey (token : Std.CancellationToken) : USize
+
+/--
+For each token that calls watch, how many of them are registered with it, and how many of those
+have ended since its entries were last swept.  A token's `unregisterFn` scans all its entries, so
+the end of a call sweeps them only once as many calls have ended as are still registered (and when
+the last ends): a token shared by k calls in flight costs a call's end O(1) amortised, not O(k),
+and holds at most about twice the entries of the calls in flight.  The counts only decide when to
+sweep: a sweep is always safe, and a finished entry left in place is skipped when the token is
+cancelled.
+-/
+structure TokenRegistry where
+  /--
+  By token (`tokenKey`, valid while a call holds the token): the calls registered, the calls that
+  ended since the last sweep.
+  -/
+  counts : Std.Mutex (Std.HashMap USize (Nat × Nat))
+
+/--
+A registry with no tokens.
+-/
+def TokenRegistry.new : BaseIO TokenRegistry := do
+  return { counts := ← Std.Mutex.new {} }
+
 /--
 Where a call's cancellation stands.
 -/
@@ -78,6 +109,11 @@ structure Cancel where
   -/
   waiters : Array (Std.CancellationToken × Waiter Unit)
 
+  /--
+  Where the registrations with the tokens are counted.
+  -/
+  registry : TokenRegistry
+
   /--
   The bell of the wait in progress (or of the last one), if a wait has armed one: rung when the call
   is fired.
@@ -125,7 +161,7 @@ so for its own token, which every call shares, by keeping a table of its calls i
 token to watch, this makes no promise and registers nothing.
 -/
 def watch (tokens : Array Std.CancellationToken)
-    (stop : IO.Ref (Option Std.CancellationReason)) : BaseIO Cancel := do
+    (stop : IO.Ref (Option Std.CancellationReason)) (registry : TokenRegistry) : BaseIO Cancel := do
   let state ← IO.mkRef .going
   let bell ← IO.mkRef none
   let hooks ← IO.mkRef #[]
@@ -141,7 +177,13 @@ def watch (tokens : Array Std.CancellationToken)
       | _ => pure ()
     discard <| start (token.selector.registerFn waiter)
     return (token, waiter)
-  return { tokens, state, waiters, bell, hooks, stop }
+  if !tokens.isEmpty then
+    registry.counts.atomically (m := BaseIO) do
+      for token in tokens do
+        modify fun m => m.alter (tokenKey token) fun
+          | some (live, ended) => some (live + 1, ended)
+          | none => some (1, 0)
+  return { tokens, state, waiters, bell, hooks, stop, registry }
 
 /--
 Cancels the call for `reason`, from outside the watch: wakes its waits as a watched token's
@@ -159,11 +201,21 @@ def finish (c : Cancel) : BaseIO Unit := do
   c.state.modify fun
     | .going | .tokenFired => .ended
     | other => other
-  -- Finish each waiter, so that its token drops it (its selector's `unregisterFn` removes the
-  -- finished ones), and release what was chained on it.
+  -- Finish each waiter, so that its token drops it at the next sweep (its selector's
+  -- `unregisterFn` removes the finished ones), and release what was chained on it.
   for (token, waiter) in c.waiters do
     waiter.race (pure ()) fun promise => promise.resolve (.error (IO.userError "the call ended"))
-    discard <| start token.selector.unregisterFn
+    let sweep ← c.registry.counts.atomically (m := BaseIO) do
+      modifyGet fun m =>
+        match m[tokenKey token]? with
+        | some (live, ended) =>
+          let live := live - 1
+          let ended := ended + 1
+          if ended ≥ live then
+            (true, if live == 0 then m.erase (tokenKey token) else m.insert (tokenKey token) (live, 0))
+          else (false, m.insert (tokenKey token) (live, ended))
+        | none => (true, m)
+    if sweep then discard <| start token.selector.unregisterFn
   -- The last wait's bell is rung only by a cancellation: dropping it drops what was chained on it.
   c.bell.set none
   c.hooks.set #[]
diff --git a/LeanHttp/Client.lean b/LeanHttp/Client.lean
index fddbfcf..81ad9ac 100644
--- a/LeanHttp/Client.lean
+++ b/LeanHttp/Client.lean
@@ -250,6 +250,11 @@ structure Client where
   -/
   inflight : Std.Mutex (Std.HashMap Nat Cancel)
 
+  /--
+  How many of the client's calls are registered with each token they were given (`TokenRegistry`).
+  -/
+  registry : TokenRegistry
+
 namespace Client
 
 /--
@@ -266,7 +271,8 @@ def new (config : Config := {}) : BaseIO Client := do
   let freed ← IO.Promise.new
   let state ← Std.Mutex.new { pool := Pool.empty (poolConfig config), freed }
   return { config, state, calls := ← IO.mkRef 0, tlsCtx := ← Std.Mutex.new none,
-           closing := ← IO.mkRef none, inflight := ← Std.Mutex.new {} }
+           closing := ← IO.mkRef none, inflight := ← Std.Mutex.new {},
+           registry := ← TokenRegistry.new }
 
 /--
 Runs `f` on the pool state under the mutex.
@@ -1121,7 +1127,7 @@ private def run {α : Type} (client : Client) (req : Request RequestBody) (maxBo
   let number ← client.calls.modifyGet fun n => (n, n + 1)
   -- The caller's token first: a call it cancelled reports its reason, even if the client is shut
   -- down afterwards.
-  let watch ← Cancel.watch cancel.toArray client.closing
+  let watch ← Cancel.watch cancel.toArray client.closing client.registry
   track client number (some watch)
   let spec : CallSpec := { client, req, xcfg, seed, started, deadline, number, cancel := watch }
   spec.observe (.start config.policy req.line kind framing seed deadline xcfg.keepAlive)
diff --git a/Tests/Unit.lean b/Tests/Unit.lean
index 07edb97..e8ebecf 100644
--- a/Tests/Unit.lean
+++ b/Tests/Unit.lean
@@ -619,10 +619,11 @@ def tlsChecks : Checks Unit := do
 /-! ## A call's cancellation -/
 
 def cancelChecks : Checks Unit := do
+  let registry ← TokenRegistry.new
   -- A token cancelled before the watch starts is seen at once, and fires the call.
   let early ← Std.CancellationToken.new
   early.cancel .shutdown
-  let c ← Cancel.watch #[early] (← IO.mkRef none)
+  let c ← Cancel.watch #[early] (← IO.mkRef none) registry
   check "a token cancelled before the watch is seen at once" (reprStr (← c.reason?) == reprStr (some Std.CancellationReason.shutdown))
   let ran ← IO.mkRef false
   c.onCancel (ran.set true)
@@ -630,7 +631,7 @@ def cancelChecks : Checks Unit := do
   c.finish
   -- A token cancelled during the call: the check asks the token, so it holds as cancel returns.
   let token ← Std.CancellationToken.new
-  let c ← Cancel.watch #[token] (← IO.mkRef none)
+  let c ← Cancel.watch #[token] (← IO.mkRef none) registry
   check "an uncancelled call has no reason" (← c.reason?).isNone
   token.cancel .cancel
   check "a check right after cancel sees it" (← c.reason?).isSome
@@ -643,7 +644,7 @@ def cancelChecks : Checks Unit := do
   -- A wait that the timer ends: its bell, the last of the call, is released when the call ends
   -- (what is chained on it then runs, with nothing), so an uncancelled call keeps nothing alive.
   let quiet ← Std.CancellationToken.new
-  let c ← Cancel.watch #[quiet] (← IO.mkRef none)
+  let c ← Cancel.watch #[quiet] (← IO.mkRef none) registry
   let waited ← (c.race (#[] : Array (Task Unit)) 1).block
   check "a wait with nothing to wait for ends at its time" (waited matches .timedOut)
   let lastBell := ((← c.bell.get).map (·.result?)).getD (Task.pure none)
@@ -657,13 +658,13 @@ def cancelChecks : Checks Unit := do
   let shared ← Std.CancellationToken.new
   let entries : BaseIO Nat := shared.state.atomically (m := BaseIO) do
     return (← get).consumers.toArray.size
-  let calls ← (List.range 5).mapM fun _ => do Cancel.watch #[shared] (← IO.mkRef none)
+  let calls ← (List.range 5).mapM fun _ => do Cancel.watch #[shared] (← IO.mkRef none) registry
   check "each call in flight is registered with its token" ((← entries) == 5)
   for c in calls do c.finish
   check "and a call that has ended is not" ((← entries) == 0)
   -- A token cancelled while a wait is in progress ends it.
   let later ← Std.CancellationToken.new
-  let c ← Cancel.watch #[later] (← IO.mkRef none)
+  let c ← Cancel.watch #[later] (← IO.mkRef none) registry
   let fired ← IO.mkRef false
   c.onCancel (fired.set true)
   let wait ← start (c.race (#[] : Array (Task Unit)) 10000)
