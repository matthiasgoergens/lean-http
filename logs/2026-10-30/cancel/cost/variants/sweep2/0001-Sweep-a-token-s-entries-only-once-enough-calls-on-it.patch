From a3dee6ba8696d0c76b543951dfa90bc35ad45107 Mon Sep 17 00:00:00 2001
From: Matthias Goergens <matthias.goergens@gmail.com>
Date: Mon, 2 Nov 2026 18:17:03 +0800
Subject: [PATCH] Sweep a token's entries only once enough calls on it have
 ended

Std's unregisterFn scans every entry of a token, so the end of a call on a
token shared by k calls in flight cost O(k), quadratic over the calls.  The
client now counts, under the lock of its table of calls, how many calls hold
each token and how many of them ended since its last sweep, and the end of a
call sweeps only once as many have ended as remain, and when the last ends.
---
 LeanHttp/Cancel.lean | 59 ++++++++++++++++++++++++++++++++++++++++----
 LeanHttp/Client.lean | 37 ++++++++++++++++++---------
 Tests/Unit.lean      | 24 ++++++++++++++++++
 3 files changed, 104 insertions(+), 16 deletions(-)

diff --git a/LeanHttp/Cancel.lean b/LeanHttp/Cancel.lean
index a423433..cb732d5 100644
--- a/LeanHttp/Cancel.lean
+++ b/LeanHttp/Cancel.lean
@@ -131,19 +131,68 @@ first.
 def cancel (c : Cancel) (reason : Std.CancellationReason) : BaseIO Unit :=
   fire c.state c.bell c.hooks (some reason)
 
+/--
+The address of a token's state, which tells tokens apart while they live.
+-/
+private unsafe def tokenKeyImpl (token : Std.CancellationToken) : USize :=
+  ptrAddrUnsafe token.state
+
+@[implemented_by tokenKeyImpl]
+private opaque tokenKey (token : Std.CancellationToken) : USize
+
+/--
+For each token that calls watch, how many of them are registered with it, and how many of those
+have ended since the token's entries were last swept (`countEnd`); a token none of them holds any
+more has no entry.  Keys are told apart by address, which is valid while a call holds the token.
+-/
+abbrev TokenCounts := Std.HashMap USize (Nat × Nat)
+
+/--
+Counts the call's registrations with its tokens.
+-/
+def countStart (c : Cancel) (counts : TokenCounts) : TokenCounts :=
+  c.waiters.foldl (init := counts) fun counts (token, _) =>
+    counts.alter (tokenKey token) fun
+      | some (live, ended) => some (live + 1, ended)
+      | none => some (1, 0)
+
+/--
+Counts the end of the call, and says for each of its tokens whether its end should sweep the
+token's entries (`finish`).  A token's `unregisterFn` scans all its entries, so a sweep at every
+end would cost a call O(k) on a token shared by k calls in flight; instead a token is swept once as
+many calls on it have ended as are still registered, and when the last ends.  Each sweep is paid
+for by the ends since the last, so an end costs O(1) amortised, and a token holds at most about
+twice the entries of the calls in flight.  A finished entry left in place is harmless: the token
+skips it when it is cancelled.
+-/
+def countEnd (c : Cancel) (counts : TokenCounts) : Array Bool × TokenCounts :=
+  c.waiters.foldl (init := (#[], counts)) fun (sweeps, counts) (token, _) =>
+    let key := tokenKey token
+    match counts[key]? with
+    | some (live, ended) =>
+      let live := live - 1
+      let ended := ended + 1
+      if ended ≥ live then
+        (sweeps.push true, if live == 0 then counts.erase key else counts.insert key (live, 0))
+      else (sweeps.push false, counts.insert key (live, ended))
+    | none => (sweeps.push true, counts)
+
 /--
 Ends the watch, once the call has ended: later cancellations of the tokens do nothing to it, and the
-last bell and the hooks, with whatever they hold, are dropped.
+last bell and the hooks, with whatever they hold, are dropped.  The token at position i of the
+call's tokens has its entries swept if `sweeps[i]` says so (`countEnd`), as by default.
 -/
-def finish (c : Cancel) : BaseIO Unit := do
+def finish (c : Cancel) (sweeps : Array Bool := #[]) : BaseIO Unit := do
   c.state.modify fun
     | none => some none
     | other => other
-  -- Finish each waiter, so that its token drops it (its selector's `unregisterFn` removes the
-  -- finished ones), and release what was chained on it.
+  -- Finish each waiter, so that its token drops it at the next sweep (its selector's `unregisterFn`
+  -- removes the finished ones), and release what was chained on it.
+  let mut i := 0
   for (token, waiter) in c.waiters do
     waiter.race (pure ()) fun promise => promise.resolve (.error (IO.userError "the call ended"))
-    discard <| start token.selector.unregisterFn
+    if sweeps.getD i true then discard <| start token.selector.unregisterFn
+    i := i + 1
   -- The last wait's bell is rung only by a cancellation: dropping it drops what was chained on it.
   c.bell.set none
   c.hooks.set #[]
diff --git a/LeanHttp/Client.lean b/LeanHttp/Client.lean
index 1c38f46..c4f2648 100644
--- a/LeanHttp/Client.lean
+++ b/LeanHttp/Client.lean
@@ -212,6 +212,15 @@ structure PoolState where
   -/
   freed : IO.Promise Unit
 
+/--
+The calls of a client in flight, and how many of them each caller's token holds.
+-/
+structure Inflight where
+  /-- The cancellation of every call in flight, by call number. -/
+  calls : Std.HashMap Nat Cancel := {}
+  /-- The registrations of those calls with the tokens they were given (`Cancel.countEnd`). -/
+  counts : Cancel.TokenCounts := {}
+
 /--
 An HTTP/1.1 client: its configuration and its connection pool.  Calls through one client from any
 number of tasks share the pool.
@@ -247,7 +256,7 @@ structure Client where
   The cancellation of every call in flight, by call number, which `shutdownNow` cancels.  A table
   rather than a watch of `closing` per call: a watch costs every call, given a token or not.
   -/
-  inflight : Std.Mutex (Std.HashMap Nat Cancel)
+  inflight : Std.Mutex Inflight
 
 namespace Client
 
@@ -350,7 +359,7 @@ def shutdownNow (client : Client) : BaseIO Unit := do
   -- The token first, so that every check made from now on sees the shutdown, then the calls in
   -- flight, whose waits it wakes; a call that starts in between finds the token cancelled.
   client.closing.cancel .shutdown
-  let calls ← client.inflight.atomically (m := BaseIO) do return (← get).toArray
+  let calls ← client.inflight.atomically (m := BaseIO) do return (← get).calls.toArray
   calls.forM fun (_, c) => c.cancel .shutdown
   client.close
 
@@ -1075,14 +1084,21 @@ private partial def CallSpec.loop {α : Type} (spec : CallSpec) (st : Call.State
     fail (spec.error st progress target f none)
 
 /--
-Records call `number`'s cancellation among the calls in flight, for `shutdownNow`, or with `none`
-forgets it.
+Records call `number`'s cancellation among the calls in flight, for `shutdownNow`, and counts its
+registrations with its tokens.
+-/
+private def track (client : Client) (number : Nat) (c : Cancel) : BaseIO Unit :=
+  client.inflight.atomically (m := BaseIO) do
+    modify fun st => { calls := st.calls.insert number c, counts := c.countStart st.counts }
+
+/--
+Forgets call `number`, once it has ended, and says which of its tokens to sweep (`Cancel.countEnd`).
 -/
-private def track (client : Client) (number : Nat) (c : Option Cancel) : BaseIO Unit :=
+private def untrack (client : Client) (number : Nat) (c : Cancel) : BaseIO (Array Bool) :=
   client.inflight.atomically (m := BaseIO) do
-    match c with
-    | some c => modify (·.insert number c)
-    | none => modify (·.erase number)
+    modifyGet fun st =>
+      let (sweeps, counts) := c.countEnd st.counts
+      (sweeps, { calls := st.calls.erase number, counts })
 
 /--
 Makes a call whose response body may be read up to `maxBody` bytes, and hands the response to `k`.
@@ -1121,14 +1137,13 @@ private def run {α : Type} (client : Client) (req : Request RequestBody) (maxBo
   -- The caller's token first: a call it cancelled reports its reason, even if the client is shut
   -- down afterwards.
   let watch ← Cancel.watch (cancel.toArray.push client.closing) cancel.toArray
-  track client number (some watch)
+  track client number watch
   let spec : CallSpec := { client, req, xcfg, seed, started, deadline, number, cancel := watch }
   spec.observe (.start config.policy req.line kind framing seed deadline xcfg.keepAlive)
   -- The call ends here, the callback included: the watch of its tokens ends with it.
   try spec.loop st {} "before the request was sent" k
   finally
-    track client number none
-    watch.finish
+    watch.finish (← untrack client number watch)
 
 /--
 Sends `req` and hands the final response to `k`, whose body `k` pulls with `BodyStream.read`.
diff --git a/Tests/Unit.lean b/Tests/Unit.lean
index a6d9472..5e23350 100644
--- a/Tests/Unit.lean
+++ b/Tests/Unit.lean
@@ -661,6 +661,30 @@ def cancelChecks : Checks Unit := do
   check "each call in flight is registered with its token" ((← entries) == 5)
   for c in calls do c.finish
   check "and a call that has ended is not" ((← entries) == 0)
+  -- With the client's counts, an end sweeps the token only once as many calls on it have ended as
+  -- remain: the token holds at most about twice the entries of the calls in flight, none at the end.
+  let counted ← Std.CancellationToken.new
+  let countedEntries : BaseIO Nat := counted.state.atomically (m := BaseIO) do
+    return (← get).consumers.toArray.size
+  let mut counts : Cancel.TokenCounts := {}
+  let mut live : Array Cancel := #[]
+  for _ in [0:8] do
+    let c ← Cancel.watch #[counted] #[counted]
+    counts := c.countStart counts
+    live := live.push c
+  let mut bounded := true
+  let mut swept := 0
+  let mut remaining := live.size
+  for c in live do
+    let (sweeps, counts') := c.countEnd counts
+    counts := counts'
+    c.finish sweeps
+    remaining := remaining - 1
+    if sweeps.contains true then swept := swept + 1
+    if (← countedEntries) > 2 * remaining + 1 then bounded := false
+  check "a token's entries stay within twice the calls in flight on it" bounded
+  check "and not every end sweeps" (swept == 4)
+  check "and the last end leaves no entries and no count" ((← countedEntries) == 0 && counts.isEmpty)
   -- A token cancelled while a wait is in progress ends it.
   let later ← Std.CancellationToken.new
   let c ← Cancel.watch #[later] #[later]
-- 
